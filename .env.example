# Copy to .env for local development. NEVER commit real secrets.
# Server-only variables are read at runtime (process.env); PUBLIC_* are inlined at build time.

# --- Environment ---------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
SITE_URL=http://localhost:4321      # public origin; used for links in emails and payment return URLs

# --- Database -----------------------------------------------------------------
# Local zero-setup: embedded PGlite (real Postgres in-process). NOT allowed in production.
DATABASE_URL=pglite:./.data/pglite
# Or real PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgres://albania:albania@localhost:5432/albania

# --- Secrets ------------------------------------------------------------------
# 32+ random characters. Signs private download URLs and mock callbacks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Payments -----------------------------------------------------------------
# mock = simulated gateway (dev/staging only; refused in production).
# paysera | pok = intentionally NOT implemented until merchant approval + documented API (see docs/payments-integration-note.md).
PAYMENT_PROVIDER=mock

# --- Access & admin ------------------------------------------------------------
ADMIN_EMAILS=owner@example.com      # comma-separated; only these can request admin sign-in links
OWNER_ALERT_EMAIL=                  # receives payment-mismatch and failed-email alerts
ACCESS_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=7
DOWNLOAD_URL_TTL_SECONDS=60
PREVIEW_ACCESS_KEY=                 # required for /preview on staging; open /preview?key=... once

# --- Email --------------------------------------------------------------------
EMAIL_TRANSPORT=console             # console (writes .data/mail/*.html) | smtp
EMAIL_FROM="Albania travel guides <no-reply@example.invalid>"
SMTP_URL=                           # e.g. smtps://user:pass@smtp.provider.example:465

# --- Private guide storage -----------------------------------------------------
STORAGE_DRIVER=local                # local | s3
PRIVATE_STORAGE_DIR=./storage/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                        # for S3-compatible providers (R2, B2, …)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CMS (Sanity) --------------------------------------------------------------
# Leave SANITY_PROJECT_ID empty to use the local sample content in src/content/fixtures.ts.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
SANITY_READ_TOKEN=                  # only if the dataset is private
SANITY_WEBHOOK_SECRET=              # shared secret of the "publish" webhook
BUILD_HOOK_URL=                     # hosting deploy hook triggered on CMS publish

# --- Serverless hosting (Vercel) ---------------------------------------------------
# Protects /api/cron/run (email retries + payment reconciliation). Vercel Cron sends it automatically.
CRON_SECRET=

# --- Public, build-time settings (brand/domain are NOT final) ------------------
PUBLIC_BRAND_NAME=Albania Decoded
PUBLIC_BRAND_TAGLINE=Know where to go. Know what’s worth it. Travel Albania like you already know it.
PUBLIC_SUPPORT_EMAIL=support@example.invalid
PUBLIC_SHOW_DRAFT_BANNER=true
PUBLIC_SHOW_PHOTO_PLACEHOLDER_LABELS=true
HOMEPAGE_HERO_VARIANT=panorama      # collage | panorama (runtime; CMS setting overrides)

# --- Map (see docs/map.md) ------------------------------------------------------
# MapLibre style URL. Default: OpenFreeMap "positron" (free, no key, OpenStreetMap data, NO SLA).
# For production use a provider with an agreement (MapTiler, Stadia Maps, self-hosted), e.g.
# PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/dataviz/style.json?key=YOUR_PUBLIC_BROWSER_KEY
PUBLIC_MAP_STYLE_URL=
PUBLIC_MAP_LABEL_FONT=Noto Sans Bold   # must exist in the style's glyph server
# Show pins whose location is not yet verified (sample town centres). Set to false for launch.
PUBLIC_MAP_SHOW_UNVERIFIED=true
