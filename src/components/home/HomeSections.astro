---
/**
 * Everything below the hero, identical for Hero A and Hero B so the client compares only the hero.
 * Layout follows the mobile reference (rows of three cards on phones, category circles, "Plan your
 * trip" tiles, closing banner). Sections that would need invented data — ratings, reviews, prices
 * for tours, "100+" claims — are intentionally left out; "Top experiences" only links existing content.
 */
import Photo from '../media/Photo.astro';
import Icon, { type IconName } from '../Icon.astro';
import Branch from '../decor/Branch.astro';
import MapPreview from '../map/MapPreview.astro';
import type { ContentBundle } from '../../features/content/schemas';
import type { CatalogPrice } from '../../features/commerce/catalog';
import { upcomingEvents, formatEventDate } from '../../features/content/events';
import { formatMoney } from '../../features/commerce/money';

interface Props {
  content: ContentBundle;
  prices: Map<string, CatalogPrice> | null;
}
const { content, prices } = Astro.props;

const featured = [...content.destinations].sort((a, b) => Number(b.featured) - Number(a.featured)).slice(0, 4);
const tagFor = (types: string[]) => (types.includes('coast') ? 'Coast' : types.includes('mountains') ? 'Nature' : types.includes('historic-town') ? 'Heritage' : 'City');
const guides = content.guides.slice(0, 3);
const spots = content.places.slice(0, 3);
const stories = content.articles.slice(0, 3);
const events = upcomingEvents(content.events).slice(0, 3);
const essentials = content.essentials.slice(0, 4);

const categories: { label: string; icon: IconName; href: string }[] = [
  { label: 'Beaches', icon: 'umbrella', href: '/destinations?experience=beach' },
  { label: 'Mountains', icon: 'mountain', href: '/destinations?experience=nature' },
  { label: 'Historic towns', icon: 'landmark', href: '/destinations?experience=culture' },
  { label: 'Food', icon: 'utensils', href: '/journal?category=food' },
  { label: 'Hidden gems', icon: 'gem', href: '/photo-spots' },
  { label: 'Lakes', icon: 'waves', href: '/map?q=lake' },
  { label: 'Cities', icon: 'building', href: '/destinations?experience=city' },
  { label: 'Itineraries', icon: 'route', href: '/journal?category=itineraries' },
];
// Top experiences: built only from places, destinations and articles that exist in the content.
const dest = (slug: string) => content.destinations.find((d) => d.slug === slug);
const place = (slug: string) => content.places.find((p) => p.slug === slug);
const article = (slug: string) => content.articles.find((a) => a.slug === slug);
const names = (types: string[]) => content.destinations.filter((d) => d.types.some((t) => types.includes(t))).map((d) => d.title);
const experiences = [
  { title: 'Hiking in the Alps', sub: 'Theth · Albanian Alps', cover: dest('theth')?.cover, href: article('hiking-in-theth') ? '/journal/hiking-in-theth' : '/destinations/theth' },
  { title: 'Riviera beaches', sub: names(['coast']).join(', '), cover: dest('ksamil')?.cover, href: '/destinations?experience=beach' },
  { title: 'Old stone towns', sub: names(['historic-town']).join(', '), cover: dest('berat')?.cover, href: '/destinations?experience=culture' },
  { title: 'Lake Komani', sub: 'Photo spot', cover: place('lake-komani')?.cover, href: '/photo-spots/lake-komani' },
  { title: 'Albanian food', sub: 'What to try', cover: article('albanian-food-to-try')?.cover, href: '/journal/albanian-food-to-try' },
].filter((e): e is typeof e & { cover: NonNullable<typeof e.cover> } => Boolean(e.cover && e.sub));
const essentialIcon: Record<string, IconName> = { bus: 'bus', bag: 'wallet', 'wifi-off': 'wifi-off', sun: 'sun', info: 'info', compass: 'compass' };
---
<!-- Popular destinations: three across on phones, four on wider screens -->
<section class="hs" aria-labelledby="h-dest">
  <div class="container">
    <div class="section-head">
      <h2 id="h-dest">Popular destinations</h2>
      <span class="section-head__rule" aria-hidden="true"></span>
      <a class="section-head__link" href="/destinations">View all <Icon name="arrow-right" size={18} /></a>
    </div>
    <ul class="hs-row hs-row--dest" role="list">
      {featured.map((d, i) => (
        <li class="dtile">
          <Photo image={d.cover} ratio="4 / 5" seed={i + 11} sizes="(max-width: 767px) 33vw, 25vw" hideLabel />
          <span class="dtile__shade" aria-hidden="true"></span>
          <span class="chip dtile__tag">{i === 0 ? 'Featured' : tagFor(d.types)}</span>
          <span class="dtile__body">
            <a class="dtile__title" href={`/destinations/${d.slug}`}>{d.title}</a>
            <span class="dtile__kicker">{d.kicker}</span>
          </span>
          <span class="dtile__go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Free vs premium, as a compact banner -->
<section class="hs" aria-labelledby="h-guides-banner">
  <div class="container">
    <div class="hbanner">
      <svg class="hbanner__art hbanner__art--castle" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.7">
          <path d="M70 14 q8 -5 16 0 t16 0 t16 0 t16 0 M70 22 q8 -5 16 0 t16 0 t16 0 t16 0 M74 30 q8 -5 16 0 t16 0 t16 0 t16 0 M80 38 q8 -5 16 0 t16 0 t16 0" />
        </g>
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M30 86V30h-4v-8h6v4h5v-4h5v4h5v-4h6v8h-4v56" />
          <path d="M34 42h3v7h-3zM43 42h3v7h-3zM38 58h4v8h-4z" />
          <path d="M51 86V56l18-14 18 14v30M47 58l22-17 22 17" />
          <path d="M58 64h5v7h-5zM74 64h5v7h-5zM65 86V76a4 4 0 0 1 8 0v10" />
          <path d="M8 92c10-8 18-4 26-8s16-2 24-6 22 2 34 0 26 6 40 8" />
          <path d="M14 96h112" stroke-width="1" />
          <path d="M32 36h18M32 52h18M32 68h18M54 76h12M76 78h10" stroke-width="0.7" opacity="0.7" />
        </g>
      </svg>
      <div class="hbanner__copy">
        <h2 id="h-guides-banner" class="hbanner__title">Ready-made plans when you want them.</h2>
        <p>Day-by-day plans and map links. Everything else here is free.</p>
      </div>
      <a class="btn btn--sm" href="/guides">Browse guides <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>

<!-- Top experiences: links to existing content only (no invented prices or ratings) -->
{experiences.length > 0 && (
  <section class="hs" aria-labelledby="h-exp">
    <div class="container">
      <div class="section-head">
        <h2 id="h-exp">Top experiences</h2>
        <span class="section-head__rule" aria-hidden="true"></span>
        <a class="section-head__link" href="/destinations">View all <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="xrow" role="list">
        {experiences.map((e, i) => (
          <li class="dtile">
            <Photo image={e.cover} ratio="3 / 4" seed={i + 61} sizes="(max-width: 767px) 42vw, 20vw" hideLabel />
            <span class="dtile__shade" aria-hidden="true"></span>
            <span class="dtile__body">
              <a class="dtile__title" href={e.href}>{e.title}</a>
              <span class="dtile__kicker">{e.sub}</span>
            </span>
            <span class="dtile__go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- Explore by category -->
<section class="hs" aria-labelledby="h-cat">
  <div class="container hs-rel">
    <Branch class="hs-sprig" flip />
    <div class="section-head">
      <h2 id="h-cat">Explore by category</h2>
    </div>
    <ul class="cats" role="list">
      {categories.map((c) => (
        <li>
          <a class="cat" href={c.href}>
            <span class="cat__icon"><Icon name={c.icon} size={24} /></span>
            <span class="cat__label">{c.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Hidden gems (photo spots) -->
{spots.length > 0 && (
  <section class="hs" aria-labelledby="h-spots">
    <div class="container">
      <div class="section-head">
        <h2 id="h-spots">Hidden gems</h2>
        <span class="section-head__rule" aria-hidden="true"></span>
        <a class="section-head__link" href="/photo-spots">View all <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="hs-row" role="list">
        {spots.map((p, i) => (
          <li class="dtile">
            <Photo image={p.cover} ratio="4 / 5" seed={i + 31} sizes="(max-width: 767px) 33vw, 30vw" hideLabel />
            <span class="dtile__shade" aria-hidden="true"></span>
            <span class="dtile__body">
              <a class="dtile__title" href={`/photo-spots/${p.slug}`}>{p.title}</a>
              <span class="dtile__kicker">{p.kind === 'beach' ? 'Beach' : p.kind === 'viewpoint' ? 'Viewpoint' : 'Photo spot'}</span>
            </span>
            <span class="dtile__go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- Free planner prompt -->
<section class="hs" aria-labelledby="h-plan">
  <div class="container">
    <div class="hbanner hbanner--plan">
      <svg class="hbanner__art" viewBox="0 0 120 90" aria-hidden="true" focusable="false">
        <path d="M8 70c20-16 34 6 54-8s30-30 50-22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 5" />
        <path d="M100 18c0 9-10 18-10 18S80 27 80 18a10 10 0 0 1 20 0z" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="90" cy="18" r="3" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <div class="hbanner__copy">
        <h2 id="h-plan" class="hbanner__title">Not sure where to start?</h2>
        <p>Plan a free trip: pick your days and interests, then arrange places day by day. Saved on your device.</p>
      </div>
      <a class="btn btn--sm" href="/plan">Plan a free trip <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>

<!-- Travel guides -->
<section class="hs" aria-labelledby="h-guides">
  <div class="container">
    <div class="section-head">
      <h2 id="h-guides">Travel guides</h2>
      <span class="section-head__rule" aria-hidden="true"></span>
      <a class="section-head__link" href="/guides">View all <Icon name="arrow-right" size={18} /></a>
    </div>
    <ul class="hs-row" role="list">
      {guides.map((g, i) => {
        const p = prices?.get(g.productSlug);
        return (
          <li class="ctile">
            <div class="ctile__media">
              <Photo image={g.cover} ratio="4 / 3" seed={i + 21} sizes="(max-width: 767px) 33vw, 30vw" hideLabel />
              {p && <span class="ctile__price">{formatMoney(p.amountMinor, p.currency)}</span>}
              <span class="ctile__badge" aria-hidden="true"><Icon name="file" size={16} /></span>
            </div>
            <div class="ctile__body">
              <a class="ctile__title" href={`/guides/${g.slug}`}>{g.title}</a>
              <span class="ctile__sub">{g.subtitle}</span>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<MapPreview />

<!-- Stories from the journal (no invented testimonials) -->
{stories.length > 0 && (
  <section class="hs" aria-labelledby="h-stories">
    <div class="container">
      <div class="section-head">
        <h2 id="h-stories">Travel stories</h2>
        <span class="section-head__rule" aria-hidden="true"></span>
        <a class="section-head__link" href="/journal">View all <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="hs-row" role="list">
        {stories.map((a, i) => (
          <li class="ctile">
            <div class="ctile__media"><Photo image={a.cover} ratio="4 / 3" seed={i + 42} sizes="(max-width: 767px) 33vw, 30vw" hideLabel /></div>
            <div class="ctile__body">
              <a class="ctile__title" href={`/journal/${a.slug}`}>{a.title}</a>
              <span class="ctile__sub">{a.category}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- Plan your trip: practical essentials -->
<section class="hs" aria-labelledby="h-essentials">
  <div class="container hs-rel">
    <Branch class="hs-sprig" flip />
    <div class="section-head">
      <h2 id="h-essentials">Plan your trip</h2>
    </div>
    <ul class="ess" role="list">
      {essentials.map((e) => (
        <li>
          <a class="ess__tile" href={`/essentials/${e.slug}`}>
            <Icon name={essentialIcon[e.icon] ?? 'info'} size={24} />
            <span class="ess__title">{e.title}</span>
            <span class="ess__sub">{e.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Events: only real, sourced events; otherwise a short honest note -->
<section class="hs" aria-labelledby="h-events">
  <div class="container">
    <div class="section-head">
      <h2 id="h-events">What’s on</h2>
      <span class="section-head__rule" aria-hidden="true"></span>
      <a class="section-head__link" href="/events">All events <Icon name="arrow-right" size={18} /></a>
    </div>
    {events.length > 0 ? (
      <ul class="hs-row" role="list">
        {events.map((e) => (
          <li class="card hs-event">
            <p class="eyebrow">{formatEventDate(e)}</p>
            <a class="ctile__title" href={`/events#${e.slug}`}>{e.title}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted hs-note">No upcoming events listed yet — we only publish events with an organiser source and a recent check date.</p>
    )}
  </div>
</section>

<!-- Closing banner -->
<section class="hs" aria-labelledby="h-diff">
  <div class="container">
    <div class="closing">
      <Photo image={{ alt: 'Stone tower in the mountains', scene: 'mountains', rights: 'placeholder' }} seed={77} sizes="100vw" hideLabel />
      <span class="closing__shade" aria-hidden="true"></span>
      <img class="closing__stamp" src="/brand/albania-stamp.webp" alt="" aria-hidden="true" width="520" height="293" loading="lazy" decoding="async" />
      <div class="closing__body">
        <h2 id="h-diff" class="closing__eyebrow">Explore Albania differently</h2>
        <p class="closing__title">More than a destination. A deeper connection.</p>
        <a class="btn btn--sm" href="/destinations">Start exploring <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  ul[role='list'] {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hs {
    padding-block: clamp(18px, 3.5vw, 40px);
  }
  .hs-rel {
    position: relative;
  }
  /* Phones: title and "View all" stay on one line, as in the reference. */
  @media (max-width: 767.98px) {
    .hs :global(.section-head) {
      flex-wrap: nowrap;
      gap: 10px;
    }
    .hs :global(.section-head h2) {
      font-size: clamp(1.35rem, 1rem + 2vw, 1.9rem);
      flex: 0 1 auto;
      min-width: 0;
    }
    .hs :global(.section-head__link) {
      font-size: 1.2rem;
      flex: none;
    }
  }
  .hs :global(.hs-sprig) {
    position: absolute;
    right: calc(var(--gutter) - 6px);
    top: -48px;
    width: clamp(40px, 6vw, 72px);
    z-index: 0;
    height: auto;
    opacity: 0.5;
  }

  /* Rows of three on phones (as in the reference); destinations show four on wider screens. */
  .hs-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 24px);
  }
  .hs-row--dest {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 767.98px) {
    .hs-row--dest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .hs-row--dest > li:nth-child(n + 4) {
      display: none;
    }
  }

  /* Image tile with title over the photo */
  .dtile {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    color: #fff;
    isolation: isolate;
  }
  .dtile:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .dtile__shade {
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(180deg, rgb(20 14 12 / 0) 0%, rgb(20 14 12 / 0.75) 100%);
  }
  .dtile__tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgb(255 253 248 / 0.92);
    font-size: clamp(0.55rem, 0.45rem + 0.5vw, 0.75rem);
    padding: 2px 8px;
  }
  .dtile__body {
    position: absolute;
    left: clamp(8px, 1.5vw, 16px);
    right: clamp(34px, 4vw, 56px);
    bottom: clamp(8px, 1.4vw, 14px);
    display: grid;
  }
  .dtile__title {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.75rem + 1.1vw, 1.6rem);
    line-height: 1.05;
  }
  .dtile__title::after {
    content: '';
    position: absolute;
    inset: -400px;
  }
  .dtile__title:focus-visible {
    outline: none;
  }
  .dtile {
    contain: paint;
  }
  .dtile__kicker {
    font-family: var(--font-display);
    font-size: clamp(0.68rem, 0.6rem + 0.35vw, 0.95rem);
    opacity: 0.95;
  }
  .dtile__go {
    position: absolute;
    right: clamp(6px, 1vw, 12px);
    bottom: clamp(8px, 1.4vw, 14px);
    width: clamp(26px, 3vw, 36px);
    height: clamp(26px, 3vw, 36px);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    display: grid;
    place-items: center;
  }

  /* Card tile: image on top, text below */
  .ctile {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .ctile:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .ctile__media {
    position: relative;
  }
  .ctile__price {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--sun);
    font-weight: 700;
    font-size: clamp(0.66rem, 0.55rem + 0.4vw, 0.85rem);
  }
  .ctile__badge {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgb(255 253 248 / 0.95);
    color: var(--burgundy);
    display: grid;
    place-items: center;
  }
  .ctile__body {
    display: grid;
    gap: 2px;
    padding: clamp(6px, 1.2vw, 14px);
  }
  .ctile__title {
    font-family: var(--font-display);
    font-size: clamp(0.86rem, 0.7rem + 0.6vw, 1.2rem);
    line-height: 1.15;
    color: var(--burgundy-dark);
    text-decoration: none;
  }
  .ctile__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ctile__title:focus-visible {
    outline: none;
  }
  .ctile__sub {
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.9rem);
    color: var(--muted);
    text-transform: capitalize;
    line-height: 1.3;
  }

  /* Banners */
  .hbanner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(10px, 2vw, 24px);
    padding: clamp(14px, 2.4vw, 24px) clamp(14px, 3vw, 28px);
    border-radius: var(--radius-lg);
    background: linear-gradient(100deg, #fbecd9, var(--cream-deep));
    border: 1px solid var(--sand);
  }
  .hbanner__art {
    width: clamp(64px, 10vw, 110px);
    color: var(--burgundy);
    opacity: 0.55;
  }
  .hbanner__title {
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.7rem);
    margin: 0 0 4px;
  }
  .hbanner__copy p {
    margin: 0;
    font-size: clamp(0.8rem, 0.72rem + 0.35vw, 1rem);
    color: var(--muted);
  }
  .hbanner__art--castle {
    width: clamp(78px, 13vw, 150px);
    color: #6f5640;
    opacity: 0.85;
  }
  /* Phones: art, copy and button stay on one row (button on the right, as in the reference). */
  @media (max-width: 599.98px) {
    .hbanner {
      gap: 8px;
      padding: 12px 10px 12px 8px;
    }
    .hbanner__art--castle {
      width: 58px;
    }
    .hbanner__title {
      font-size: 0.98rem;
      line-height: 1.15;
    }
    .hbanner__copy p {
      font-size: 0.72rem;
      line-height: 1.3;
    }
    .hbanner .btn {
      font-size: 0.78rem;
      padding: 8px 10px;
      min-height: 40px;
      gap: 4px;
      white-space: nowrap;
    }
    .hbanner .btn :global(svg) {
      width: 14px;
      height: 14px;
    }
  }

  /* Top experiences: a swipeable row on phones, a grid on wider screens. */
  .xrow {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 42%);
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding: 2px var(--gutter) 6px;
    scroll-padding-inline: var(--gutter);
  }
  .xrow::-webkit-scrollbar {
    display: none;
  }
  .xrow > li {
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .xrow {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow: visible;
      margin-inline: 0;
      padding: 0;
      gap: clamp(10px, 1.6vw, 20px);
    }
  }

  /* Category circles: four per row */
  .cats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px) clamp(6px, 2vw, 24px);
  }
  @media (min-width: 900px) {
