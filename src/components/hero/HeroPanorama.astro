---
/**
 * Hero B — panoramic direction from the new references: landscape panorama blending into cream,
 * stacked logo, dark editorial title over a quiet area, search field and burgundy primary action.
 * Text is HTML, never part of the image. Desktop and mobile crops use separate focal points.
 */
import Photo from '../media/Photo.astro';
import Icon from '../Icon.astro';
import SearchBox from '../search/SearchBox.astro';
import PostStamp from '../decor/PostStamp.astro';
import type { HeroProps } from './types';

type Props = Omit<HeroProps, 'variant'>;
const { heading, description, media, primaryAction, secondaryAction, tagline } = Astro.props;
const image = media[0];
const features = [
  { icon: 'pin', label: 'Destinations' },
  { icon: 'route', label: 'Ready-made plans' },
  { icon: 'compass', label: 'Local tips' },
  { icon: 'book', label: 'Digital guides' },
] as const;
---
<section class="hero-pano" aria-labelledby="hero-heading">
  <div class="hero-pano__media">
    <Photo image={image} priority sizes="100vw" />
    <div class="hero-pano__fade" aria-hidden="true"></div>
  </div>

  <div class="container hero-pano__content">
    <div class="hero-pano__brand">
      {tagline && <p class="hero-pano__tagline">{tagline}</p>}
    </div>
    <img class="hero-pano__stamp" src="/brand/albania-stamp.webp" alt="" aria-hidden="true" width="520" height="293" decoding="async" />

    <div class="hero-pano__copy">
      <h1 id="hero-heading">{heading}</h1>
      <p class="hero-pano__desc">{description}</p>
      <span class="hero-pano__rule" aria-hidden="true"></span>
    </div>

    <div class="hero-pano__search">
      <PostStamp kind="flowers" class="hero-pano__flowers" />
      <SearchBox variant="hero" id="hero-q" />
    </div>

    <div class="hero-pano__lower">
    <PostStamp class="hero-pano__poststamp" />
    <div class="hero-pano__actions">
      <a class="btn" href={primaryAction.href}>{primaryAction.label} <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn--outline" href={secondaryAction.href}><Icon name="bag" size={18} /> {secondaryAction.label}</a>
    </div>

    <ul class="hero-pano__features">
      {features.map((f) => (
        <li><span class="hero-pano__ficon"><Icon name={f.icon} size={22} /></span>{f.label}</li>
      ))}
    </ul>
    </div>
  </div>
</section>

<style>
  .hero-pano {
    position: relative;
    z-index: 2; /* keeps the search dropdown above the sections that follow */
    background: var(--cream);
    isolation: isolate;
    margin-top: calc(-1 * var(--overlay-h));
  }
  .hero-pano__media {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(78vh, 720px);
    min-height: 520px;
    z-index: -1;
  }
  .hero-pano__fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(250 245 235 / 0.94) 0%, rgb(250 245 235 / 0.75) 34%, rgb(250 245 235 / 0) 60%),
      linear-gradient(180deg, rgb(250 245 235 / 0) 55%, var(--cream) 98%);
  }
  /* Reference detail: dried flowers peeking above the search field, and a postage stamp with an
     olive sprig in a narrow left margin beside the buttons and the four icons. */
  .hero-pano__search {
    position: relative;
  }
  .hero-pano__search :global(.hero-pano__flowers) {
    position: absolute;
    left: calc(-1 * var(--gutter) + 2px);
    bottom: 34%;
    width: clamp(50px, 5vw, 80px);
    height: auto;
    opacity: 0.8;
    z-index: -1;
  }
  .hero-pano__lower {
    --decor-w: clamp(54px, 9vw, 108px);
    position: relative;
    grid-column: 1;
    padding-left: var(--decor-w);
  }
  .hero-pano__lower :global(.hero-pano__poststamp) {
    position: absolute;
    left: calc(-0.5 * var(--gutter) - 6px);
    top: 2px;
    width: calc(var(--decor-w) * 1.75);
    height: auto;
    z-index: -1;
  }
  .hero-pano__content {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--overlay-h) + 4px);
    padding-bottom: clamp(24px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 620px) 1fr;
    column-gap: 24px;
  }
  .hero-pano__brand,
  .hero-pano__copy,
  .hero-pano__search,
  .hero-pano__actions,
  .hero-pano__features {
    grid-column: 1;
  }
  .hero-pano__tagline {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
    max-width: 40ch;
    margin: 10px 0 0;
  }
  /* Wide screens only (narrower screens show the stamp beside the logo in the header). */
  .hero-pano__stamp {
    position: absolute;
    right: calc(var(--gutter) + 16%);
    top: calc(var(--overlay-h) + 8px);
    width: 210px;
    height: auto;
    pointer-events: none;
  }
  .hero-pano__copy {
    margin-top: clamp(24px, 4vw, 48px);
  }
  .hero-pano__copy h1 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5rem);
    color: var(--burgundy-dark);
    margin-bottom: 0.25em;
  }
  .hero-pano__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    max-width: 34ch;
    margin: 0;
  }
  .hero-pano__rule {
    display: block;
    width: 96px;
    height: 2px;
    background: var(--gold);
    margin-top: 14px;
  }
  .hero-pano__search {
    margin-top: clamp(24px, 5vw, 56px);
    max-width: 640px;
  }
  .hero-pano__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
  }
  .hero-pano__actions .btn {
    flex: 0 1 auto;
    min-width: 190px;
  }
  .hero-pano__features {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .hero-pano__features li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    font-size: 0.86rem;
    line-height: 1.25;
    padding-inline: 6px;
  }
  .hero-pano__features li + li {
    border-left: 1px solid var(--sand-line);
  }
  .hero-pano__ficon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--burgundy-tint);
    color: var(--burgundy);
  }

  @media (max-width: 1080.98px) {
    .hero-pano__stamp {
      display: none;
    }
  }

  /* Phones: everything up to the two buttons fits the first screen (checked down to 360×640). */
  @media (max-width: 767.98px) {
    .hero-pano__media {
      height: min(560px, 82svh);
      min-height: 0;
    }
    .hero-pano__fade {
      background:
        linear-gradient(180deg, rgb(250 245 235 / 0.55) 0%, rgb(250 245 235 / 0.2) 35%, rgb(250 245 235 / 0.55) 62%, var(--cream) 94%),
        linear-gradient(90deg, rgb(250 245 235 / 0.7) 0%, rgb(250 245 235 / 0.15) 75%);
    }
    .hero-pano__content {
      grid-template-columns: minmax(0, 1fr);
      padding-top: calc(var(--overlay-h) + 2px);
      padding-bottom: 20px;
    }
    .hero-pano__tagline {
      display: none;
    }
    .hero-pano__copy {
      margin-top: clamp(8px, 3svh, 32px);
    }
    .hero-pano__copy h1 {
      font-size: clamp(2.1rem, 1.3rem + 4vw, 2.7rem);
      text-shadow: 0 0 22px rgb(250 245 235 / 0.9);
    }
    .hero-pano__desc {
      font-size: 1.05rem;
      text-shadow: 0 0 14px rgb(250 245 235 / 0.95);
    }
    .hero-pano__rule {
      display: none;
    }
    .hero-pano__search {
      margin-top: clamp(14px, 3svh, 28px);
    }
    .hero-pano__actions {
      margin-top: 12px;
    }
    .hero-pano__actions .btn {
      flex: 1 1 120px;
      min-width: 0;
      padding-inline: 10px;
      white-space: nowrap;
      font-size: 0.9rem;
      gap: 6px;
    }
    /* Four icons in one straight row, as in the reference. */
    .hero-pano__features {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      margin-top: 22px;
    }
    .hero-pano__features li {
      font-size: 0.74rem;
      padding-inline: 2px;
      overflow-wrap: anywhere;
    }
    .hero-pano__ficon {
      width: 40px;
      height: 40px;
    }
    .hero-pano__ficon :global(svg) {
      width: 20px;
      height: 20px;
    }
  }
  @media (max-width: 767.98px) and (max-height: 620px) {
    .hero-pano__copy h1 {
      font-size: 2rem;
    }
    .hero-pano__desc {
      font-size: 0.95rem;
    }
  }
  /* Tall phones have room for the tagline again. */
  @media (max-width: 767.98px) and (min-height: 800px) {
    .hero-pano__tagline {
      display: block;
      font-size: 0.95rem;
      margin-top: 4px;
    }
  }
</style>
