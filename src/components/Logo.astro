---
import { site } from '../config/site';

interface Props {
  /** compact = header on normal pages; hero = larger, over the panorama hero */
  size?: 'compact' | 'hero';
  brand?: string;
}
const { size = 'compact', brand = site.brandName } = Astro.props;
// The supplied artwork spells "Albania Decoded"; any other (provisional) brand falls back to text.
const useImage = brand.trim().toLowerCase() === 'albania decoded';
---
<a href="/" class:list={['logo', `logo--${size}`, { 'logo--text': !useImage }]}>
  {useImage ? (
    <picture>
      <source srcset="/brand/albania-decoded-logo.webp" type="image/webp" />
      <img class="logo__img" src="/brand/albania-decoded-logo.png" alt="Albania Decoded" width="640" height="374" decoding="async" />
    </picture>
  ) : (
    <>
      <svg class="logo__mark" viewBox="0 0 64 30" aria-hidden="true" focusable="false">
        <path d="M2 28 L18 10 L25 17 L35 4 L50 20 L56 15 L62 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
      </svg>
      <span class="logo__text">{brand}</span>
    </>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--burgundy-dark);
    text-decoration: none;
    font-family: var(--font-display);
    line-height: 0.95;
    min-height: 44px;
    flex: none;
  }
  .logo__img {
    display: block;
    width: auto;
    height: var(--logo-h, 50px);
  }
  .logo--compact {
    --logo-h: 50px;
  }
  .logo--hero {
    --logo-h: var(--logo-hero-h);
  }
  @media (max-width: 767.98px) {
    .logo--compact {
      --logo-h: 42px;
    }
  }
  .logo__mark {
    width: 34px;
    height: auto;
  }
  .logo__text {
    font-size: clamp(1.1rem, 0.9rem + 1.2vw, 1.4rem);
    letter-spacing: 0.01em;
  }
</style>
