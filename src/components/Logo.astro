---
import { site } from '../config/site';

interface Props {
  variant?: 'stacked' | 'inline';
  brand?: string;
}
const { variant = 'inline', brand = site.brandName } = Astro.props;
const words = brand.split(' ');
---
<a href="/" class:list={['logo', `logo--${variant}`]} aria-label={`${brand} — home`}>
  <svg class="logo__mark" viewBox="0 0 64 30" aria-hidden="true" focusable="false">
    <path d="M2 28 L18 10 L25 17 L35 4 L50 20 L56 15 L62 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
    <path d="M31 9.5 L35 4 L39 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="logo__text">
    {variant === 'stacked' ? words.map((w) => <span>{w}</span>) : brand}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--burgundy-dark);
    text-decoration: none;
    font-family: var(--font-display);
    line-height: 0.95;
    min-height: 44px;
  }
  .logo__mark {
    width: 34px;
    height: auto;
    flex: none;
  }
  .logo--inline .logo__text {
    font-size: clamp(1.1rem, 0.9rem + 1.2vw, 1.4rem);
    letter-spacing: 0.01em;
  }
  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .logo--stacked .logo__mark {
    width: 64px;
  }
  .logo--stacked .logo__text {
    display: flex;
    flex-direction: column;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.3rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>
