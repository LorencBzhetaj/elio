---
/** Save / remove toggle for the on-device trip. Same state as the map and My trip (see trip/client.ts). */
import Icon from '../Icon.astro';

interface Props {
  /** destination slug, or place:<slug> */
  slug: string;
  title: string;
}
const { slug, title } = Astro.props;
---
<div class="add-trip" data-add-trip={slug} data-title={title}>
  <button class="btn btn--block" type="button" data-add-btn aria-pressed="false">
    <Icon name="plus" size={18} /> <span data-label>Add to my trip</span>
  </button>
  <p class="add-trip__status" role="status" aria-live="polite" data-status></p>
  <noscript><p class="muted">The trip planner needs JavaScript enabled.</p></noscript>
</div>

<script>
  import { onTripChange, savedDay, storageAvailable, toggleSaved } from '../../features/trip/client';

  document.querySelectorAll<HTMLElement>('[data-add-trip]').forEach((root) => {
    const id = root.dataset.addTrip!;
    const title = root.dataset.title!;
    const btn = root.querySelector<HTMLButtonElement>('[data-add-btn]')!;
    const label = root.querySelector<HTMLElement>('[data-label]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    const render = () => {
      if (!storageAvailable()) {
        btn.disabled = true;
        status.textContent = 'Your browser is blocking storage, so trips cannot be saved here.';
        return;
      }
      const day = savedDay(id);
      label.textContent = day === null ? 'Add to my trip' : `Saved · day ${day + 1} (remove)`;
      btn.setAttribute('aria-pressed', String(day !== null));
      btn.classList.toggle('btn--outline', day !== null);
    };

    btn.addEventListener('click', () => {
      const saved = toggleSaved(id);
      if (saved === null) {
        status.textContent = 'Could not save — browser storage is full or blocked.';
        return;
      }
      status.replaceChildren(saved ? `${title} saved to day 1. ` : `${title} removed from your trip. `);
      const a = document.createElement('a');
      a.href = '/my-trip';
      a.textContent = 'Open my trip';
      status.append(a);
    });
    onTripChange(render);
    render();
  });
</script>

<style>
  .add-trip__status {
    margin: 8px 0 0;
    font-size: 0.9rem;
    min-height: 1.4em;
  }
</style>
