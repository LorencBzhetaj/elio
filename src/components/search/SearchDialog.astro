---
/**
 * Site-wide search dialog. Phones: full screen, field on top, results below, sized to the visual viewport
 * so the on-screen keyboard never covers the controls. Desktop: a panel under the header.
 * Opened by any [data-open-search] trigger or a `search:open` event; closing restores scroll and focus.
 */
import SearchBox from './SearchBox.astro';
---
<dialog id="search-dialog" class="sdialog" aria-label="Search">
  <SearchBox variant="dialog" id="sd-q">
    <button slot="after-input" type="button" class="sdialog__cancel" data-close-search>Cancel</button>
  </SearchBox>
</dialog>

<script>
  import { initSearchBox } from '../../features/search/ui';

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const root = dialog.querySelector<HTMLElement>('[data-search]')!;
    let opener: HTMLElement | null = null;
    let scrollY = 0;
    const box = initSearchBox(root, { variant: 'dialog', onEscape: () => dialog.close() });

    const fitViewport = () => {
      const vv = window.visualViewport;
      if (vv) dialog.style.setProperty('--sd-height', `${vv.height}px`);
    };

    function openSearch(query = '', from: HTMLElement | null = null) {
      opener = from ?? (document.activeElement as HTMLElement | null);
      scrollY = window.scrollY;
      if (!dialog!.open) dialog!.showModal();
      // Lock background scroll without losing the position (overflow:hidden resets it on phones).
      document.body.style.top = `-${scrollY}px`;
      document.documentElement.classList.add('search-open');
      fitViewport();
      box.setQuery(query, true);
      box.focus();
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open-search]');
      if (!trigger) return;
      e.preventDefault();
      openSearch('', trigger);
    });
    window.addEventListener('search:open', (e) => {
      const { query, opener: from } = (e as CustomEvent).detail ?? {};
      openSearch(query ?? '', from ?? null);
    });
    dialog.querySelector('[data-close-search]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // backdrop (desktop)
    });
    dialog.addEventListener('close', () => {
      // Returning focus to the hero field must not reopen the dialog (see SearchBox).
      document.documentElement.setAttribute('data-search-closing', '');
      setTimeout(() => document.documentElement.removeAttribute('data-search-closing'), 400);
      document.documentElement.classList.remove('search-open');
      document.body.style.top = '';
      window.scrollTo({ top: scrollY, behavior: 'instant' });
      opener?.focus({ preventScroll: true });
    });
    window.visualViewport?.addEventListener('resize', fitViewport);
  }
</script>

<style is:global>
  html.search-open body {
    position: fixed;
    inset-inline: 0;
    overflow: hidden;
  }
  .sdialog {
    border: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .sdialog::backdrop {
    background: rgb(41 34 31 / 0.45);
  }
  .sdialog .sbox {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .sdialog .sbox__form {
    flex: none;
    margin: 12px;
    box-shadow: none;
    border-radius: 999px;
  }
  .sdialog .sbox__panel {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 12px 16px;
  }
  .sdialog__cancel {
    flex: none;
    border: 0;
    background: none;
    color: var(--burgundy);
    font-weight: 600;
    min-height: 44px;
    padding: 0 10px;
    cursor: pointer;
  }
  /* Phones: full screen, sized to the visual viewport (keyboard-aware). */
  @media (max-width: 767.98px) {
    .sdialog {
      width: 100vw;
      max-width: 100vw;
      height: var(--sd-height, 100dvh);
      max-height: var(--sd-height, 100dvh);
      margin: 0;
      inset: 0 auto auto 0;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
  }
  /* Desktop/tablet: panel below the header. */
  @media (min-width: 768px) {
    .sdialog {
      width: min(720px, calc(100vw - 32px));
      max-height: min(80vh, 720px);
      height: min(80vh, 720px);
      margin: 72px auto auto;
      border-radius: 20px;
      box-shadow: var(--shadow-lift);
    }
  }
</style>
