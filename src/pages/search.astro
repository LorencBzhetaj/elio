---
/**
 * Kept so existing /search?q=… links work. It opens the same search interface (panel always open,
 * query pre-filled, URL kept in sync). Server-rendered results remain as the no-JavaScript fallback.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/content/PageHeader.astro';
import SearchBox from '../components/search/SearchBox.astro';
import { loadContent } from '../features/content/queries';
import { buildSearchIndex, search, SEARCH_TYPES, type SearchTypeFilter } from '../features/content/search';
import { regions } from '../features/content/schemas';

export const prerender = false;

const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
// Old links used type=essential; it now belongs to "Articles".
const rawType = Astro.url.searchParams.get('type') === 'essential' ? 'article' : Astro.url.searchParams.get('type');
const type = SEARCH_TYPES.find((t) => t.id === rawType)?.id as SearchTypeFilter | undefined;
const region = regions.find((r) => r === Astro.url.searchParams.get('region'));
const fallback = q ? search(buildSearchIndex(await loadContent()), { q, type, region }, 50) : { total: 0, results: [] };
---
<BaseLayout title={q ? `Search: ${q}` : 'Search'} noindex>
  <PageHeader title="Search" />
  <div class="container narrow section" style="padding-top: 0">
    <SearchBox variant="page" id="page-q" query={q} type={type} region={region} />
    <noscript>
      <p class="muted">{fallback.total} {fallback.total === 1 ? 'result' : 'results'}{q && ` for “${q}”`}</p>
      <ul>
        {fallback.results.map((r) => <li><a href={r.url}>{r.title}</a> — {r.category}</li>)}
      </ul>
    </noscript>
  </div>
</BaseLayout>
