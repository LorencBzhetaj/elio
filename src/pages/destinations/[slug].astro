---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/media/Photo.astro';
import Icon from '../../components/Icon.astro';
import Blocks from '../../components/content/Blocks.astro';
import VerifyNote from '../../components/content/VerifyNote.astro';
import GuidePromo from '../../components/content/GuidePromo.astro';
import SpotCard from '../../components/cards/SpotCard.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import AddToTrip from '../../components/trip/AddToTrip.astro';
import { loadContent } from '../../features/content/queries';
import type { Destination } from '../../features/content/schemas';

export async function getStaticPaths() {
  const c = await loadContent();
  return c.destinations.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

interface Props {
  d: Destination;
}
const { d } = Astro.props;
const content = await loadContent();
const guide = content.guides.find((g) => g.productSlug === d.relatedGuideProductId);
const places = content.places.filter((p) => d.placeSlugs.includes(p.slug) || p.destinationSlug === d.slug);
const articles = content.articles.filter((a) => d.relatedArticleSlugs.includes(a.slug) || a.destinationSlugs.includes(d.slug));

const sections = [
  { id: 'when-to-go', title: 'When to go', icon: 'sun', blocks: d.whenToGo },
  { id: 'getting-there', title: 'How to get there', icon: 'bus', blocks: d.howToArrive },
  { id: 'things-to-do', title: 'Things to do', icon: 'compass', blocks: d.thingsToDo },
] as const;

const site = Astro.site;
const jsonLd = site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Destinations', item: new URL('/destinations', site).href },
        { '@type': 'ListItem', position: 2, name: d.title, item: new URL(`/destinations/${d.slug}`, site).href },
      ],
    }
  : undefined;
---
<BaseLayout title={d.title} description={d.seoDescription ?? d.summary} jsonLd={jsonLd} canonical={d.canonical}>
  <section class="dhero">
    <div class="dhero__media"><Photo image={d.cover} priority sizes="100vw" /></div>
    <div class="dhero__fade" aria-hidden="true"></div>
    <div class="container dhero__body">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a href="/destinations">Destinations</a></li><li aria-current="page">{d.title}</li></ol>
      </nav>
      <p class="dhero__kicker"><Icon name="pin" size={16} /> {d.kicker}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <VerifyNote verified={d.verified} updatedAt={d.updatedAt} />
    </div>
  </section>

  <div class="container dlayout">
    <div class="dmain">
      {d.highlights.length > 0 && (
        <ul class="dhighlights" aria-label="Highlights">
          {d.highlights.map((h) => <li><Icon name="check" size={18} />{h}</li>)}
        </ul>
      )}

      <nav class="dtoc" aria-label="On this page">
        <ul>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          {places.length > 0 && <li><a href="#places">Places</a></li>}
        </ul>
      </nav>

      {sections.map((s) => (
        <section id={s.id} class="dsection prose" aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`}><Icon name={s.icon} size={26} /> {s.title}</h2>
          <Blocks blocks={s.blocks} />
        </section>
      ))}

      {places.length > 0 && (
        <section id="places" class="dsection" aria-labelledby="places-h">
          <h2 id="places-h">Places</h2>
          <ul class="grid grid--3" role="list" style="list-style:none;padding:0">
            {places.map((p, i) => <li><SpotCard place={p} seed={i + 61} /></li>)}
          </ul>
        </section>
      )}
    </div>

    <aside class="daside" aria-label="Plan and guides">
      <div class="card daside__trip">
        <h2 class="daside__h"><Icon name="map" size={22} /> Add to your trip</h2>
        <p class="muted">Save {d.title} to a day in your plan. Stored on this device only.</p>
        <AddToTrip slug={d.slug} title={d.title} />
      </div>
      {guide && <GuidePromo guide={guide} />}
    </aside>
  </div>

  {articles.length > 0 && (
    <section class="section section--tint" aria-labelledby="rel-h">
      <div class="container">
        <h2 id="rel-h">Read more</h2>
        <ul class="rel-list" role="list">
          {articles.map((a, i) => <li><ArticleCard article={a} seed={i + 71} /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .dhero {
    position: relative;
    min-height: clamp(380px, 52vw, 560px);
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .dhero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .dhero__fade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(250 245 235 / 0) 30%, rgb(250 245 235 / 0.85) 72%, var(--cream) 100%);
  }
  .dhero__body {
    padding-bottom: 12px;
  }
  .dhero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgb(41 34 31 / 0.7);
    color: #fff;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.9rem;
    margin: 0 0 10px;
  }
  .dhero h1 {
    font-size: var(--step-5);
    margin-bottom: 0.1em;
  }
  .dlayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 40px;
    padding-block: 24px 48px;
  }
  @media (max-width: 899.98px) {
    .dlayout {
      grid-template-columns: 1fr;
    }
  }
  .dhighlights {
    list-style: none;
    padding: 16px 20px;
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    background: var(--paper);
    border-radius: var(--radius);
    border: 1px solid var(--sand);
  }
  .dhighlights li {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .dhighlights :global(.icon) {
    color: var(--burgundy);
  }
  .dtoc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    padding: 0 0 8px;
    margin: 0 0 8px;
    border-bottom: 1px solid var(--sand);
  }
  .dtoc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .dtoc a:hover {
    color: var(--burgundy);
    text-decoration: underline;
  }
  .dsection {
    padding-top: 20px;
  }
  .dsection h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step-2);
  }
  .dsection h2 :global(.icon) {
    color: var(--burgundy);
  }
  .daside {
    display: grid;
    gap: 20px;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }
  @media (max-width: 899.98px) {
    .daside {
      position: static;
    }
  }
  .daside__trip {
    padding: 20px;
  }
  .daside__h {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step-1);
  }
  .rel-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    max-width: 760px;
  }
</style>
