---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import DestinationCard from '../../components/cards/DestinationCard.astro';
import FilterBar from '../../components/filters/FilterBar.astro';
import Icon from '../../components/Icon.astro';
import { loadContent } from '../../features/content/queries';
import { destinationListing, EXPERIENCES } from '../../features/filters/listings';
import { applyFilters, readState } from '../../features/filters/core';

// Rendered on request so the URL (query, filters, sort) works on refresh and without JavaScript.
export const prerender = false;

const content = await loadContent();
const { items, groups, sorts, defaultSort } = destinationListing(content);

// Backwards compatibility: earlier links used ?type=coast etc.
const params = new URLSearchParams(Astro.url.search);
for (const t of params.getAll('type')) {
  const exp = EXPERIENCES.find((e) => (e.types as readonly string[]).includes(t));
  if (exp) params.append('experience', exp.value);
}
const state = readState(params, groups, sorts, defaultSort);
const visible = applyFilters(items, state);
const shown = new Set(visible.map((v) => v.id));
const bySlug = new Map(content.destinations.map((d) => [d.slug, d]));
// Server order = current sort; hidden items follow so the client can reveal them without a reload.
const ordered = [...visible.map((v) => v.id), ...items.map((i) => i.id).filter((id) => !shown.has(id))];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---
<BaseLayout title="Destinations" description="Mountains, coast, historic towns and cities across Albania — free destination pages.">
  <PageHeader title="Find your Albania" note="Mountains · Riviera · Cities" intro="Mountains, coastline, historic towns and cities — practical, free destination pages." />
  <section class="container section" style="padding-top: 8px" aria-label="Destinations">
    <FilterBar
      id="dest-filters"
      searchLabel="Search destinations"
      noun={['destination', 'destinations']}
      groups={groups}
      sorts={sorts}
      defaultSort={defaultSort}
      state={state}
      total={visible.length}
      items={items}
      listId="dest-list"
    />
    <p class="dest-maplink"><a href="/map"><Icon name="map" size={18} /> View destinations on the map</a></p>
    <ul class="grid dest-grid" id="dest-list" role="list">
      {ordered.map((slug, i) => (
        <li data-id={slug} hidden={!shown.has(slug)}><DestinationCard destination={bySlug.get(slug)!} seed={i + 51} headingLevel="h2" /></li>
      ))}
    </ul>
    <div class="notice" data-fempty="dest-list" hidden={visible.length > 0}>
      <p><strong>No destinations match.</strong> Try another word or remove a filter.</p>
      <p><button type="button" class="btn btn--sm btn--outline" data-fempty-clear>Clear filters</button></p>
    </div>
  </section>
</BaseLayout>

<style>
  .dest-grid {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .dest-grid > [hidden] {
    display: none;
  }
  @media (max-width: 539.98px) {
    .dest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .dest-maplink {
    margin: 0;
  }
  .dest-maplink a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
  }
  [data-fempty][hidden] {
    display: none;
  }
</style>
