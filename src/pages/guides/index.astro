---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import GuideCard from '../../components/cards/GuideCard.astro';
import Icon from '../../components/Icon.astro';
import { loadContent } from '../../features/content/queries';
import { loadDisplayPrices } from '../../lib/prices';
import FilterBar from '../../components/filters/FilterBar.astro';
import { guideListing } from '../../features/filters/listings';
import { applyFilters, readState } from '../../features/filters/core';

export const prerender = false;

const content = await loadContent();
const { guides } = content;
const prices = await loadDisplayPrices();
const { items, groups, sorts, defaultSort } = guideListing(content, prices);
const state = readState(Astro.url.searchParams, groups, sorts, defaultSort);
const visible = applyFilters(items, state);
const shown = new Set(visible.map((i) => i.id));
const bySlug = new Map(guides.map((g) => [g.slug, g]));
const ordered = [...visible.map((v) => v.id), ...items.map((i) => i.id).filter((id) => !shown.has(id))];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---
<BaseLayout title="Digital guides" description="Optional digital guides for Albania: ready-made plans, practical notes and map links. One-time purchase, no account needed.">
  <PageHeader title="Less planning. More Albania." note="Local insights · Real places" intro="Optional digital guides with ready-made plans, practical notes and map links. Everything practical on this site stays free." />
  <div class="container section" style="padding-top: 8px">
    <ul class="gfacts" aria-label="How guides work">
      <li><Icon name="lock" /> One-time purchase</li>
      <li><Icon name="mail" /> No account — access by email</li>
      <li><Icon name="download" /> PDF works offline once downloaded</li>
      <li><Icon name="map" /> Map links need internet</li>
    </ul>
    <FilterBar id="guide-filters" searchLabel="Search guides" noun={['guide', 'guides']} groups={groups} sorts={sorts} defaultSort={defaultSort} state={state} total={visible.length} items={items} listId="guide-list" />
    <ul class="grid ggrid" id="guide-list" role="list">
      {ordered.map((slug, i) => {
        const g = bySlug.get(slug)!;
        const p = prices?.get(g.productSlug);
        return <li data-id={slug} hidden={!shown.has(slug)}><GuideCard guide={g} price={p ? { amountMinor: p.amountMinor, currency: p.currency } : null} seed={i + 111} headingLevel="h2" /></li>;
      })}
    </ul>
    <div class="notice" data-fempty="guide-list" hidden={visible.length > 0}>
      <p><strong>No guides match.</strong></p>
      <p><button type="button" class="btn btn--sm btn--outline" data-fempty-clear>Clear filters</button></p>
    </div>
    <p class="muted gnote">Already bought a guide? <a href="/access">Get a new access link</a>.</p>
  </div>
</BaseLayout>

<style>
  .gfacts {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .gfacts li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .gfacts :global(.icon) {
    color: var(--burgundy);
  }
  .ggrid > [hidden],
  [data-fempty][hidden] {
    display: none;
  }
  .ggrid {
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .gnote {
    margin-top: 24px;
  }
</style>
