---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getDb } from '../features/services';
import { listOwnedGuides } from '../features/access/downloads';
import { currentSession } from '../lib/session';
import { site } from '../config/site';

export const prerender = false;

const session = await currentSession(Astro.cookies);
const guides = session ? await listOwnedGuides(await getDb(), session.email) : [];
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="My guides" noindex>
  <div class="container section mg">
    <h1>My guides</h1>
    {!session ? (
      <div class="card mg__card">
        <p class="lead">Sign in with a secure link sent to the email you used at checkout.</p>
        <a class="btn" href="/access"><Icon name="mail" size={18} /> Email me an access link</a>
      </div>
    ) : (
      <>
        <p class="muted">Signed in as <strong>{session.email}</strong> on this device.</p>
        {error === 'download' && <div class="notice notice--warn" role="alert"><p>That download isn’t available. If you think this is wrong, contact <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.</p></div>}
        {guides.length === 0 ? (
          <div class="card mg__card">
            <p>No active guides for this email address. Purchases appear here once payment is confirmed.</p>
            <a class="btn btn--outline" href="/guides">Browse guides</a>
          </div>
        ) : (
          <ul class="mg__list" role="list">
            {guides.map((g) => (
              <li class="card mg__card">
                <h2 class="mg__title">{g.title}</h2>
                <p class="muted">Version {g.version}</p>
                {g.assets.length === 0 ? (
                  <p class="notice notice--warn">The guide file is being prepared. We’ll email you when it’s ready.</p>
                ) : (
                  <ul class="mg__assets" role="list">
                    {g.assets.map((a) => (
                      <li>
                        <a class="btn btn--sm" href={`/api/downloads/${a.id}`} rel="noopener noreferrer" target={a.kind === 'map_link' ? '_blank' : undefined}>
                          <Icon name={a.kind === 'pdf' ? 'download' : 'map'} size={18} />
                          {a.kind === 'pdf' ? `Download ${a.label}` : `Open ${a.label}`}
                          {a.kind === 'map_link' && <span class="visually-hidden"> (opens in a new tab, needs internet)</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="muted mg__small">PDF works offline after download. Map links need an internet connection.</p>
              </li>
            ))}
          </ul>
        )}
        <form method="post" action="/api/access/logout"><button class="btn btn--ghost btn--sm" type="submit">Sign out on this device</button></form>
      </>
    )}
  </div>
</BaseLayout>

<style>
  .mg__card {
    padding: 22px;
    margin-top: 12px;
  }
  .mg__list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: grid;
    gap: 14px;
  }
  .mg__title {
    font-size: var(--step-2);
    margin: 0;
  }
  .mg__assets {
    list-style: none;
    padding: 0;
    margin: 12px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .mg__small {
    font-size: 0.88rem;
    margin: 0;
  }
</style>
