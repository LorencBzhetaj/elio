---
import '@fontsource-variable/dm-sans/index.css';
import '../styles/global.css';

interface Props {
  title: string;
  email?: string;
}
const { title, email } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin</title>
  </head>
  <body class="admin">
    <header class="admin__bar">
      <a href="/admin/orders" class="admin__brand">Orders admin</a>
      {email && (
        <form method="post" action="/api/access/logout" class="admin__out">
          <span>{email}</span>
          <button class="btn btn--sm btn--outline" type="submit">Sign out</button>
        </form>
      )}
    </header>
    <main id="main" class="container section">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin {
    background: #f6f4f0;
    padding-bottom: 0;
  }
  .admin__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px var(--gutter);
    background: #1f1a18;
    color: #fff;
  }
  .admin__brand {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .admin__out {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
  }
  .admin__out .btn {
    --btn-fg: #fff;
    --btn-border: rgb(255 255 255 / 0.5);
  }
  .admin table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    font-size: 0.92rem;
  }
  .admin th,
  .admin td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid #eee6d8;
    vertical-align: top;
  }
  .admin th {
    background: #faf5eb;
  }
  .admin .table-wrap {
    overflow-x: auto;
  }
  .admin h1 {
    font-size: var(--step-3);
  }
  .admin .status {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: #eee;
    font-weight: 600;
    font-size: 0.82rem;
  }
  .admin .status--paid { background: #d9f2df; }
  .admin .status--pending { background: #dfeaf6; }
  .admin .status--refunded, .admin .status--needs_review { background: #fde2e1; }
</style>
